    # -- small helpers ---------------------------------------------------

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text))

    def set_busy(self, busy):
        self.busy = busy
        self.refresh_sensitivity()

    def refresh_sensitivity(self):
        free = not self.busy
        self.refresh_button.set_sensitive(free and not self.checking)
        self.show_state()
        for button in getattr(self, "action_buttons", []):
            button.set_sensitive(free)
        self.all_button.set_sensitive(
            free and bool(self.packages or self.channels))
        for rows in (self.update_rows, self.source_rows, self.result_rows,
                     self.mine_rows):
            rows.set_sensitive(free)

    def show_terminal(self, shown=True):
        if shown and not self.terminal_pane.get_visible():
            self.terminal_pane.set_visible(True)
            # Room for the terminal, unless the window is too short.
            height = self.paned.get_height()
            if height > 0:
                self.paned.set_position(
                    max(height // 3, height - self.terminal_height))
        elif not shown and self.terminal_pane.get_visible():
            self.terminal_height = (self.paned.get_height()
                                    - self.paned.get_position())
            self.terminal_pane.set_visible(False)

    def toggle_details(self):
        self.show_terminal(not self.terminal_pane.get_visible())

    def say(self, text):
        """Write a line of our own into the terminal pane."""
        self.terminal.feed(("\r\n\x1b[1m" + text + "\x1b[0m\r\n").encode())

    def query(self, arguments, done, label=None):
        """Run `guix bump ARGUMENTS --porcelain' in the background; call
        DONE with its lines of output, or None if it failed.  What it says
        for people goes to the terminal pane.  With LABEL, it shows in the
        status strip and Cancel stops it."""
        if not self.busy:
            self.say("$ guix bump " + " ".join(arguments))
        argv = [guix(), "bump"] + arguments + ["--porcelain"]
        # Its own process group, so that Cancel reaches what it starts.
        if label and shutil.which("setsid"):
            argv = [shutil.which("setsid")] + argv
        try:
            process = Gio.Subprocess.new(
                argv, Gio.SubprocessFlags.STDOUT_PIPE
                | Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as error:
            self.terminal.feed((error.message + "\r\n").encode())
            done(None)
            return
        lines = []
        if label:
            self.begin()
            self.queries[process] = label
            self.show_state()

        def finished(process, result):
            cancelled = self.cancelling and process in self.queries
            self.queries.pop(process, None)
            try:
                process.wait_finish(result)
                ok = process.get_successful() and "done" in lines
            except GLib.Error:
                ok = False
            if label:
                if cancelled:
                    self.finish(f"{label}: cancelled",
                                "process-stop-symbolic", 0)
                elif ok:
                    self.finish(f"{label}: done", "emblem-ok-symbolic", 1)
                else:
                    self.finish(f"{label}: failed (see the terminal)",
                                "dialog-warning-symbolic", 0)
                if not (self.busy or self.queries):
                    self.cancelling = False
                    self.show_state()
            done(lines if ok and not cancelled else None)

        def read(stream, keep):
            def on_line(source, result):
                try:
                    line, _ = source.read_line_finish_utf8(result)
                except GLib.Error:
                    line = None
                if line is None:
                    if keep:
                        process.wait_async(None, finished)
                    return
                if keep:
                    lines.append(line)
                elif not self.busy:
                    # While a command runs, the terminal and the strip are
                    # its own: a background query doesn't write there.
                    self.terminal.feed((line + "\r\n").encode())
                    if label and line.strip():
                        self.work_line.set_text(line.strip())
                read(stream, keep)
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        read(Gio.DataInputStream.new(process.get_stderr_pipe()), False)
        read(Gio.DataInputStream.new(process.get_stdout_pipe()), True)

    def refresh(self):
        self.check()
        self.load_installed()

    # -- Updates ---------------------------------------------------------

    def show_status(self, icon, title, description="", working=False):
        self.status.set_icon_name(None if working else icon)
        self.status.set_child(self.spinner if working else None)
        if working:
            self.spinner.start()
        else:
            self.spinner.stop()
        self.status.set_title(title)
        self.status.set_description(description)
        self.updates.set_visible_child_name("status")

    def check(self):
        if self.checking or self.busy:
            return
        self.checking = True
        self.refresh_sensitivity()
        self.show_status(
            None, "Looking for updates",
            "The first look after new commits prepares the newer Guix, "
            "which can take several minutes.  Later ones take seconds.",
            working=True)
        self.query(["--check"], self.check_done, "Looking for updates")

    def check_done(self, lines):
        self.checking = False
        if lines is None:
            self.show_status(
                "dialog-warning-symbolic", "Could not look for updates",
                "`guix bump --check' failed; the reason is in the terminal "
                "below.")
            self.show_terminal()
            self.refresh_sensitivity()
            return
        self.packages, self.channels = [], []
        for line in lines:
            fields = line.split("\t")
            if fields[0] == "package" and len(fields) == 7:
                self.packages.append(dict(
                    name=fields[1], installed=fields[2], newest=fields[3],
                    channel=fields[4], where=fields[5],
                    pulled=fields[6] == "pulled"))
            elif fields[0] == "channel" and len(fields) == 4:
                self.channels.append(dict(
                    name=fields[1], pinned=fields[2], latest=fields[3]))
        self.fill_updates()

    def button(self, label, callback, style=None, tooltip=None):
        button = Gtk.Button(label=label, tooltip_text=tooltip)
        if style:
            button.add_css_class(style)
        button.connect("clicked", lambda *_: callback())
        return button

    def fill_updates(self):
        self.update_rows.clear()
        self.source_rows.clear()
        if not self.packages and not self.channels:
            self.show_status("emblem-ok-symbolic", "Everything is up to date",
                             "Every installed app is at its newest version.")
            self.refresh_sensitivity()
            return
        for package in self.packages:
            notes = [f"{package['installed']} → {package['newest']}",
                     f"from {package['channel']}"]
            if package["where"] == "system":
                notes.append("part of the system: asks for your password")
            if package["channel"] == "guix":
                notes.append("updates everything from Guix")
            self.update_rows.add(
                package["name"], "  ·  ".join(notes),
                [self.button("Update", lambda p=package: self.update_app(p),
                             tooltip=runs(self.update_app_arguments(package)))])
        self.all_button.set_tooltip_text(
            runs(self.update_all_arguments(), "Update everything listed"))
        self.update_rows.group.set_description(
            "" if self.packages else "No app has a newer version.")
        for channel in self.channels:
            self.source_rows.add(
                channel["name"],
                f"{short(channel['pinned'])} → {short(channel['latest'])}",
                [self.button("Update",
                             lambda c=channel: self.update_channel(c),
                             tooltip=runs(["bump", channel["name"],
                                           "--home"],
                                          "Everything from this source"))])
        self.source_rows.group.set_visible(bool(self.channels))
        self.updates.set_visible_child_name("list")
        self.refresh_sensitivity()

    # -- Install ---------------------------------------------------------

    def search(self):
        words = self.search_entry.get_text().split()
        if not words:
            return
        self.search_serial += 1
        serial = self.search_serial
        self.search_status.set_icon_name(None)
        spinner = Gtk.Spinner(halign=Gtk.Align.CENTER)
        spinner.set_size_request(32, 32)
        spinner.start()
        self.search_status.set_child(spinner)
        self.search_status.set_title("Searching")
        self.search_status.set_description("")
        self.results.set_visible_child_name("status")
        self.query(["--search"] + words,
                   lambda lines: self.search_done(serial, words, lines),
                   "Searching")

    def search_done(self, serial, words, lines):
        if serial != self.search_serial:
            return                      # an older search; a newer one runs
        self.search_status.set_child(None)
        self.search_status.set_icon_name("system-search-symbolic")
        self.result_rows.clear()
        results = [line.split("\t") for line in lines or []
                   if line.startswith("result\t")]
        results = [fields for fields in results if len(fields) == 5]
        if lines is None or not results:
            self.search_status.set_title(
                "The search failed" if lines is None else "Nothing found")
            self.search_status.set_description(
                "The reason is in the terminal (menu: show the terminal)."
                if lines is None else
                f"No package matches “{' '.join(words)}”.")
            self.results.set_visible_child_name("status")
            return
        for _, name, version, state, synopsis in results:
            if state == "installed":
                label = Gtk.Label(label="Installed")
                label.add_css_class("dim-label")
                widgets = [label]
            else:
                widgets = [self.button("Install",
                                       lambda n=name: self.install(n),
                                       "suggested-action",
                                       runs(["bump", "--install", name],
                                            "Add it to your config file "
                                            "and install it"))]
            self.result_rows.add(f"{name}  {version}", synopsis, widgets)
        self.result_rows.group.set_description(
            "The first 100 matches; add a word to narrow it down."
            if len(results) >= 100 else "")
        self.results.set_visible_child_name("list")
        self.refresh_sensitivity()

    def install(self, name):
        self.run(["bump", "--install", name],
                 f"Installing {name}: adding it to your config file, then "
                 "applying.")

    # -- Installed -------------------------------------------------------

    def load_installed(self):
        self.query(["--installed"], self.installed_done,
                   "Reading your apps")
        self.query(["--settings"], self.settings_done)

    def settings_done(self, lines):
        """Say so when the package list of the settings can't be found."""
        missing = False
        for line in lines or []:
            fields = line.split("\t")
            if fields[0] == "setting" and len(fields) == 4 \
                    and fields[1] == "config":
                self.config_path = fields[3].split(" (", 1)[0]
                self.folder_button.set_tooltip_text(
                    "Open the folder of your config file\n"
                    + self.config_path)
            if fields[0] == "setting" and len(fields) == 4 \
                    and fields[1] == "packages":
                missing = fields[3].startswith("no (define")
                if missing:
                    self.list_banner.set_title(
                        "Your config file has no package list called "
                        f"{fields[2] or '%managed-packages'}, so nothing "
                        "here can be changed.  Name the list it has in "
                        "Settings.")
        self.list_banner.set_revealed(missing)

    def installed_done(self, lines):
        if lines is None:
            return
        self.installed = []
        for line in lines:
            fields = line.split("\t")
            if fields[0] == "installed" and len(fields) == 6:
                self.installed.append(dict(
                    name=fields[1], version=fields[2],
                    mine=fields[3] == "list", spec=fields[4],
                    versions=[v for v in fields[5].split(",") if v]))
        self.fill_installed()

    def fill_installed(self):
        self.mine_rows.clear()
        self.other_rows.clear()
        wanted = self.filter_entry.get_text().lower()
        mine = 0
        for package in self.installed:
            name = package["name"]
            if wanted and wanted not in name.lower():
                continue
            if not package["mine"]:
                self.other_rows.add(name, package["version"])
                continue
            mine += 1
            widgets = []
            if len(package["versions"]) > 1:
                widgets.append(self.version_chooser(package))
            widgets.append(self.button("Remove",
                                       lambda n=name: self.remove(n),
                                       "destructive-action",
                                       runs(["bump", "--remove", name],
                                            "Take it out of your config "
                                            "file and uninstall it")))
            pinned = "@" in package["spec"]
            self.mine_rows.add(
                name,
                package["version"]
                + ("  ·  kept at this version" if pinned
                   else "  ·  follows the newest version"),
                widgets)
        self.mine_group.set_visible(mine > 0 or not wanted)
        self.refresh_sensitivity()

    def version_chooser(self, package):
        """A drop-down of the versions there are; choosing one installs it."""
        newest = "newest"
        choices = [newest] + package["versions"]
        chooser = Gtk.DropDown.new_from_strings(choices)
        chooser.set_tooltip_text(
            "Which version to keep\n\nChoosing one runs: guix bump "
            f"--install {package['name']}@VERSION (newest: guix bump "
            f"--install {package['name']})")
        if "@" in package["spec"]:
            current = package["spec"].split("@", 1)[1]
            if current in choices:
                chooser.set_selected(choices.index(current))

        def chosen(chooser, _param):
            version = choices[chooser.get_selected()]
            name = package["name"]
            spec = name if version == newest else f"{name}@{version}"
            if spec != package["spec"]:
                self.run(["bump", "--install", spec],
                         f"Changing {name} to "
                         + ("the newest version." if version == newest
                            else f"version {version}."))
        chooser.connect("notify::selected", chosen)
        return chooser

    def remove(self, name):
        self.confirm(
            f"Remove {name}?",
            "It is taken out of your config file and uninstalled.  Its own "
            "settings and files in your home folder stay."
            f"\n\nRuns: guix bump --remove {name}",
            "Remove",
            lambda: self.run(["bump", "--remove", name],
                             f"Removing {name}: taking it out of your "
                             "config file, then applying."),
            destructive=True)

    # -- running commands in the terminal --------------------------------

    def on_output(self, terminal):
        """Show the current step (`==> ...' lines of guix bump) and the
        latest line the command printed."""
        if not self.busy:
            return
        try:
            text = terminal.get_text_format(Vte.Format.TEXT)
        except (AttributeError, TypeError):
            return
        if isinstance(text, tuple):
            text = text[0]
        lines = [line.strip() for line in (text or "").splitlines()]
        lines = [line for line in lines if line]
        if not lines:
            return
        self.work_line.set_text(lines[-1])
        for line in reversed(lines):
            if line.startswith("$ guix "):
                break                   # this command's first line
            if line.startswith("==> "):
                self.work_step.set_text(
                    f"{self.work_what}  ·  {line[4:].rstrip('.')}")
                break

    def run(self, arguments, hint):
        """Run `guix ARGUMENTS' in the terminal pane."""
        if self.busy:
            self.toast("Something is still running; wait for it to finish")
            return
        self.begin()
        self.work_what = hint.split(":")[0].rstrip(".")
        self.work_step.set_text(self.work_what)
        self.work_line.set_text(command_text(arguments))
        self.set_busy(True)
        self.hint.set_text(hint + "  If it asks something, click in the "
                           "terminal below and type the answer.")
        self.show_terminal()
        self.say("$ " + command_text(arguments))

        def spawned(_terminal, pid, error, *_):
            self.child_pid = pid if pid and pid > 0 else None
        self.terminal.spawn_async(
            Vte.PtyFlags.DEFAULT, os.path.expanduser("~"),
            [guix()] + arguments, None, GLib.SpawnFlags.DEFAULT,
            None, None, -1, None, spawned)
        self.terminal.grab_focus()

    def on_child_exited(self, _terminal, status):
        ok = os.waitstatus_to_exitcode(status) == 0
        cancelled = self.cancelling
        self.child_pid = None
        self.busy = False
        if not self.queries:
            self.cancelling = False
        seconds = int(time.monotonic() - self.work_started)
        took = f"{seconds // 60}:{seconds % 60:02d}"
        if cancelled and not ok:
            self.finish(f"{self.work_what}: cancelled after {took}",
                        "process-stop-symbolic", 0)
        elif ok:
            self.finish(f"{self.work_what}: done in {took}",
                        "emblem-ok-symbolic", 1)
        else:
            self.finish(f"{self.work_what}: failed after {took}",
                        "dialog-warning-symbolic", 0)
        self.refresh_sensitivity()
        if cancelled and not ok:
            self.toast("Cancelled")
            self.hint.set_text("Cancelled.  Nothing was switched; the "
                               "config file is as it was.")
            self.fill_installed()
        elif ok:
            self.toast("Done")
            self.hint.set_text("Done.  Apps that were open keep their old "
                               "version until you close and reopen them.")
            self.refresh()
            if self.search_entry.get_text().split():
                self.search()           # "Install" becomes "Installed"
        else:
            self.toast("That did not work; see the terminal below")
            self.hint.set_text("That did not work.  Nothing was switched; "
                               "the reason is in the text below.")
            self.fill_installed()       # put a changed drop-down back

    # -- settings --------------------------------------------------------

    def show_settings(self):
        """Which file and which lists in it `guix bump' works on, and what
        it does with git.  Each setting is its own group: the field, then
        what it comes to now."""
        dialog = Adw.PreferencesDialog(title="Settings")
        page = Adw.PreferencesPage()
        rows = {}                       # key: (entry or combo, effect, note)
        state = {"updating": False}

        def section(title, description):
            label = Adw.PreferencesGroup(title=title, description=description)
            page.add(label)

        def entry_setting(key, title, note, browse=False):
            group = Adw.PreferencesGroup()
            entry = Adw.EntryRow(title=title, show_apply_button=True)
            effect = Adw.ActionRow(title=escape(note), subtitle="")
            effect.add_css_class("property")
            entry.connect("apply",
                          lambda e: change(key, e.get_text().strip()))
            entry.set_tooltip_text(
                f"Pressing ✓ runs: guix bump --set {key}=VALUE "
                "(empty: the default)")
            if browse:
                button = Gtk.Button(icon_name="document-open-symbolic",
                                    valign=Gtk.Align.CENTER,
                                    tooltip_text="Choose the file")
                button.add_css_class("flat")

                def chosen(chooser, result):
                    try:
                        file = chooser.open_finish(result)
                    except GLib.Error:
                        return
                    entry.set_text(file.get_path())
                    change(key, file.get_path())
                button.connect(
                    "clicked",
                    lambda *_: Gtk.FileDialog(
                        title="Your Guix config file").open(self, None,
                                                            chosen))
                entry.add_suffix(button)
            group.add(entry)
            group.add(effect)
            page.add(group)
            rows[key] = (entry, effect, note)

        section("Your config file",
                "Guix Manager changes one file: your Guix config.  Say where "
                "it is and what its lists are called.  Leave a field empty "
                "for the usual name.")
        entry_setting("config", "Config file", "Usually ~/config.scm",
                      browse=True)
        entry_setting("packages", "Name of the package list",
                      "The list Install and Remove edit; usually "
                      "%managed-packages")
        entry_setting("channels", "Name of the channel list",
                      "The channels to update; empty means every channel in "
                      "the file")

        section("Keeping the config file in git",
                "When the config file is in a git repository, each change "
                "can be committed there, and pushed to a remote (GitHub, "
                "say), so its history is the machine's history.")
        modes = ["push", "commit", "off"]
        git_group = Adw.PreferencesGroup()
        git_row = Adw.ComboRow(
            title="Each change",
            model=Gtk.StringList.new(["Commit and push", "Commit only",
                                      "Don't use git"]),
            tooltip_text="Choosing runs: guix bump --set "
                         "git=push|commit|off")
        git_effect = Adw.ActionRow(title="What happens", subtitle="")
        git_effect.add_css_class("property")
        git_group.add(git_row)
        git_group.add(git_effect)
        page.add(git_group)
        rows["git"] = (git_row, git_effect, "What happens")

        def git_chosen(row, _param):
            if not state["updating"]:
                change("git", modes[row.get_selected()])
        git_row.connect("notify::selected", git_chosen)

        entry_setting("git-remote", "Remote to push to",
                      "The repository's `origin', for example "
                      "https://github.com/you/my-guix.git; empty removes it")
        entry_setting("git-name", "Commit author name",
                      "This repository's user.name; empty uses your global "
                      "git setting")
        entry_setting("git-email", "Commit author email",
                      "This repository's user.email (a GitHub no-reply "
                      "address keeps yours private); empty uses your global "
                      "git setting")

        def show(lines):
            state["updating"] = True
            for line in lines or []:
                fields = line.split("\t")
                if fields[0] != "setting" or len(fields) != 4 \
                        or fields[1] not in rows:
                    continue
                widget, effect, note = rows[fields[1]]
                if fields[1] == "git":
                    widget.set_selected(modes.index(fields[2])
                                        if fields[2] in modes else 0)
                elif widget.get_text() != fields[2]:
                    widget.set_text(fields[2])
                effect.set_subtitle(escape("In use: " + fields[3]))
            state["updating"] = False

        def change(key, value):
            def changed(lines):
                if lines is None:
                    self.toast("That setting was not changed; see the "
                               "terminal")
                    self.show_terminal()
                    self.query(["--settings"], show)
                    return
                show(lines)
                self.refresh()
            self.query(["--set", f"{key}={value}"], changed,
                       "Saving settings")

        dialog.add(page)
        self.query(["--settings"], show)
        dialog.present(self)

    def confirm(self, heading, body, label, callback, destructive=False):
        dialog = Adw.AlertDialog(heading=heading, body=body)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", label)
        dialog.set_response_appearance(
            "go", Adw.ResponseAppearance.DESTRUCTIVE if destructive
            else Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response",
                       lambda _d, response: response == "go" and callback())
        dialog.present(self)

    @staticmethod
    def update_app_arguments(package):
        if package["channel"] == "guix" and not package["pulled"]:
            return ["bump", package["name"], "--yes"]
        return ["bump", package["name"]]

    def update_app(self, package):
        name = package["name"]
        arguments = self.update_app_arguments(package)
        if "--yes" in arguments:
            # `guix bump' would ask this in the terminal; ask it here.
            self.confirm(
                "Update everything from Guix?",
                f"{name} comes from Guix itself.  Updating it updates every "
                "package Guix provides, which can mean a lot to download or "
                "compile.\n\nRuns: " + command_text(arguments),
                "Update everything",
                lambda: self.run(arguments,
                                 f"Updating {name} and the rest of Guix."))
        else:
            self.run(arguments, f"Updating {name}.")

    def update_channel(self, channel):
        self.run(["bump", channel["name"], "--home"],
                 f"Updating everything from {channel['name']}.")

    def update_all_arguments(self):
        flags = ["--home"]
        if any(package["where"] == "system" for package in self.packages):
            flags = ["--system", "--home"]
        return ["bump", "all"] + flags

    def update_all(self):
        self.run(self.update_all_arguments(), "Updating everything.")

    def nightly(self):
        self.confirm(
            "Update everything, then power off?",
            "Updates every source, applies the system and your apps, cleans "
            "up old versions and turns the computer off when it has "
            "finished.  It asks for your password once, now.  The screens "
            "turn off while it works: move the mouse to look."
            "\n\nRuns: guix nightly",
            "Update and power off",
            lambda: self.run(["nightly"],
                             "Updating everything; the computer powers off "
                             "at the end."))

    def undo(self):
        self.confirm(
            "Undo the last update?",
            "Puts every source back to what it was before the last update "
            "and applies that to your apps."
            "\n\nRuns: guix bump --undo --home",
            "Undo",
            lambda: self.run(["bump", "--undo", "--home"],
                             "Going back to before the last update."))


class Application(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        window = self.props.active_window or Window(self)
        window.present()


if __name__ == "__main__":
    sys.exit(Application().run(sys.argv))
