#!/usr/bin/env python3
"""Guix Manager: a window on `guix bump'.

Three pages: Updates (installed apps that have a newer version), Install
(search for a package and add it) and Installed (remove one, or choose its
version).  Every button runs the command a person would type (`guix bump
APP', `guix bump --install NAME', ...) in the terminal pane at the bottom,
so password and yes/no questions are answered there, and every change goes
through the config file.  The window keeps no state and decides nothing
itself: all the logic is in `guix bump'.
"""

import os
import shutil
import signal
import sys
import time

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Vte", "3.91")
from gi.repository import Adw, Gio, GLib, Gtk, Pango, Vte  # noqa: E402

APP_ID = "io.github.lightningbulb2.GuixManager"
VERSION = "2.5"


def guix():
    """The `guix' to run: the one `guix pull' maintains, else the PATH's."""
    pulled = os.path.expanduser("~/.config/guix/current/bin/guix")
    return pulled if os.path.exists(pulled) else "guix"


def command_text(arguments):
    """ARGUMENTS of `guix' as a person would type them."""
    return "guix " + " ".join(arguments)


def runs(arguments, what=""):
    """A tooltip: WHAT a button does, then the command it runs."""
    command = command_text(arguments)
    return f"{what}\n\nRuns: {command}" if what else f"Runs: {command}"


def short(commit):
    return commit[:10]


def escape(text):
    return GLib.markup_escape_text(text)


class RowList:
    """The rows of one Adw.PreferencesGroup, replaceable as a whole."""

    def __init__(self, group):
        self.group = group
        self.rows = []

    def clear(self):
        for row in self.rows:
            self.group.remove(row)
        self.rows = []

    def add(self, title, subtitle, widgets=()):
        row = Adw.ActionRow(title=escape(title), subtitle=escape(subtitle))
        row.set_subtitle_lines(2)
        row.controls = list(widgets)
        for widget in widgets:
            widget.set_valign(Gtk.Align.CENTER)
            row.add_suffix(widget)
        self.group.add(row)
        self.rows.append(row)
        return row

    def set_sensitive(self, sensitive):
        for row in self.rows:
            for widget in row.controls:
                widget.set_sensitive(sensitive)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Guix Manager")
        self.set_default_size(820, 760)
        self.busy = False          # a command is running in the terminal
        self.checking = False
        self.child_pid = None      # that command's process
        self.cancelling = False
        self.queries = {}          # background `guix bump' runs: label
        self.config_path = None    # from `guix bump --settings'
        self.last_outcome = "Ready"
        self.packages = []         # rows of the last update check
        self.channels = []
        self.installed = []        # rows of the last `--installed'
        self.search_serial = 0

        # The pages.
        self.pages = Adw.ViewStack(vexpand=True)
        self.pages.add_titled_with_icon(
            self.build_updates(), "updates", "Updates",
            "software-update-available-symbolic")
