    # -- the status strip: what is happening, always shown ---------------

    def build_status(self):
        """A strip under the buttons: what is running (or what happened
        last), the step it is on, its latest line of output, the time so
        far, a bar, and Cancel."""
        self.work_icon = Gtk.Image(icon_name="emblem-ok-symbolic")
        self.work_spinner = Gtk.Spinner()
        self.work_indicator = Gtk.Stack()
        self.work_indicator.add_named(self.work_icon, "idle")
        self.work_indicator.add_named(self.work_spinner, "busy")
        self.work_indicator.set_size_request(20, 20)
        self.work_step = Gtk.Label(xalign=0, hexpand=True,
                                   ellipsize=Pango.EllipsizeMode.END,
                                   label="Ready")
        self.work_step.add_css_class("heading")
        self.work_time = Gtk.Label(xalign=1)
        self.work_time.add_css_class("numeric")
        self.work_time.add_css_class("dim-label")
        self.cancel_button = Gtk.Button(
            label="Cancel", sensitive=False,
            tooltip_text="Stop what is running, as Ctrl-C in a terminal "
                         "would.  A command stopped halfway switches "
                         "nothing: the config file is put back.")
        self.cancel_button.add_css_class("destructive-action")
        self.cancel_button.connect("clicked", lambda *_: self.cancel())
        top = Gtk.Box(spacing=10)
        top.append(self.work_indicator)
        top.append(self.work_step)
        top.append(self.work_time)
        top.append(self.cancel_button)
        self.work_line = Gtk.Label(xalign=0, label="Nothing is running.",
                                   ellipsize=Pango.EllipsizeMode.MIDDLE)
        self.work_line.add_css_class("dim-label")
        self.work_line.add_css_class("caption")
        self.work_bar = Gtk.ProgressBar()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                      margin_start=12, margin_end=12, margin_top=4,
                      margin_bottom=8)
        box.append(top)
        box.append(self.work_line)
        box.append(self.work_bar)
        self.work_started = 0
        GLib.timeout_add(250, self.tick)
        return box

    def tick(self):
        """Every quarter second: the time so far and the moving bar."""
        if self.busy or self.queries:
            seconds = int(time.monotonic() - self.work_started)
            self.work_time.set_text(f"{seconds // 60}:{seconds % 60:02d}")
            self.work_bar.pulse()
        return True

    def show_state(self):
        """Put what is running now, or what happened last, in the strip."""
        running = self.busy or bool(self.queries)
        self.cancel_button.set_sensitive(running and not self.cancelling)
        if running:
            self.work_indicator.set_visible_child_name("busy")
            self.work_spinner.start()
            if not self.busy:
                self.work_step.set_text(
                    "  ·  ".join(dict.fromkeys(self.queries.values())))
            self.set_title(f"Guix Manager: {self.work_step.get_text()}")
        else:
            self.work_spinner.stop()
            self.work_indicator.set_visible_child_name("idle")
            self.work_step.set_text(self.last_outcome)
            self.set_title("Guix Manager")

    def begin(self):
        """Something starts: restart the clock if nothing else runs."""
        if not (self.busy or self.queries):
            self.work_started = time.monotonic()
            self.work_time.set_text("0:00")
            self.work_bar.set_fraction(0)

    def finish(self, outcome, icon, fraction):
        """Something ended: say how, once nothing else runs."""
        self.last_outcome = outcome
        self.work_icon.set_from_icon_name(icon)
        if not (self.busy or self.queries):
            self.work_bar.set_fraction(fraction)
        self.show_state()

    def cancel(self):
        """Stop the running command and the background queries."""
        self.cancelling = True
        self.cancel_button.set_sensitive(False)
        self.work_line.set_text("Stopping…")
        for process in list(self.queries):
            self.signal_group(process.get_identifier(), signal.SIGTERM)
        if self.busy:
            # Ctrl-C, as typed in the terminal: every process of the
            # command gets SIGINT, and `guix bump' cleans up after itself.
            try:
                self.terminal.feed_child(b"\x03")
            except TypeError:
                self.terminal.feed_child("\x03", 1)

            def force():
                if self.busy and self.child_pid:
                    self.signal_group(self.child_pid, signal.SIGTERM)
                return False
            GLib.timeout_add_seconds(10, force)
        if not self.busy:
            self.cancelling = False

    @staticmethod
    def signal_group(pid, sig):
        if not pid:
            return
        try:
            os.killpg(os.getpgid(int(pid)), sig)
        except (ProcessLookupError, PermissionError, ValueError):
            pass

    # -- the config file's folder ----------------------------------------

    def open_config_folder(self):
        if not self.config_path:
            self.toast("The config file isn't known yet")
            return
        file = Gio.File.new_for_path(self.config_path)
        try:
            Gtk.FileLauncher.new(file).open_containing_folder(
                self, None, None)
        except (AttributeError, TypeError):
            Gio.AppInfo.launch_default_for_uri(
                Gio.File.new_for_path(os.path.dirname(self.config_path))
                .get_uri(), None)

    # -- the bar of whole-machine actions --------------------------------

