            self.build_install(), "install", "Install",
            "system-search-symbolic")
        self.pages.add_titled_with_icon(
            self.build_installed(), "installed", "Installed",
            "view-list-symbolic")

        # Header: the page switcher, look again, more.
        self.refresh_button = Gtk.Button(
            icon_name="view-refresh-symbolic",
            tooltip_text="Look again for updates and installed apps\n\n"
                         "Runs: guix bump --check, guix bump --installed "
                         "(with --porcelain: output for this window)")
        self.folder_button = Gtk.Button(
            icon_name="folder-open-symbolic",
            tooltip_text="Open the folder of your config file")
        self.folder_button.connect("clicked",
                                   lambda *_: self.open_config_folder())
        self.refresh_button.connect("clicked", lambda *_: self.refresh())
        menu = Gio.Menu()
        menu.append("Update everything, then power off", "win.nightly")
        menu.append("Undo the last update", "win.undo")
        menu.append("Show or hide the terminal", "win.details")
        menu.append("Settings", "win.settings")
        for name, callback in (("nightly", self.nightly),
                               ("undo", self.undo),
                               ("details", self.toggle_details),
                               ("settings", self.show_settings)):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _a, _p, f=callback: f())
            self.add_action(action)
        header = Adw.HeaderBar(
            title_widget=Adw.ViewSwitcher(
                stack=self.pages, policy=Adw.ViewSwitcherPolicy.WIDE))
        header.pack_start(self.refresh_button)
        header.pack_start(self.folder_button)
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic",
                                       menu_model=menu))

        # The terminal pane the commands run in.
        self.terminal = Vte.Terminal()
        self.terminal.set_scrollback_lines(20000)
        self.terminal.set_font(Pango.FontDescription("monospace 10"))
        self.terminal.connect("child-exited", self.on_child_exited)
        self.terminal.connect("contents-changed", self.on_output)
        self.hint = Gtk.Label(xalign=0, margin_start=12, margin_top=6,
                              margin_bottom=6, wrap=True)
        self.hint.add_css_class("dim-label")

        pane = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        pane.append(self.hint)
        pane.append(Gtk.ScrolledWindow(child=self.terminal, vexpand=True,
                                       min_content_height=80))
        pane.set_visible(False)
        self.terminal_pane = pane

        # The pages above, the terminal below; drag the line between them.
        self.toasts = Adw.ToastOverlay(child=self.pages)
        self.paned = Gtk.Paned(orientation=Gtk.Orientation.VERTICAL,
                               start_child=self.toasts, end_child=pane,
                               resize_start_child=True,
                               resize_end_child=False,
                               shrink_start_child=False,
                               shrink_end_child=False,
